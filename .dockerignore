# Virtual environments
.venv/
venv/
ENV/

# Secrets and local environment (never bake .env or key material)
.env
.env.*
*.pem
*.key

# Model weights (mounted via volume, never copied)
models/
*.gguf
*.bin

# Local runtime state: catalog, ledgers, backups, logs
db/
database/*.db
*.db
*.db-wal
*.db-shm
logs/
programs/

# Local dataset artifacts. The catalog seed CSV and the catalog pictures are
# build inputs; the raw JSON dump, the videos and the rest of the local data
# stay out (they are large and gitignored).
data/*
!data/processed_exercises.csv
# Catalog pictures ship in the image so the public GET /media route can serve
# them (#161); everything else under data/ stays excluded.
!data/images/
!data/images/**

# Future Flutter client (not part of the API image)
mobile/

# Local caches & artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Agent tooling and design/test scratch (a local .claude/ can hold GBs of
# worktrees; none of it is a build input, and it slows every `fly deploy`)
.claude/
.pytest_cwd/
UI_app_design/
.agents/
.wrangler/
plans/
# Only the privacy policy is read at runtime (service/privacy_policy.py).
docs/*
!docs/PRIVACY_POLICY.md

# Git & IDE
.git/
.gitignore
.vscode/
.idea/
