# Virtual environments
.venv/
venv/
ENV/

# Secrets and local environment (never bake .env or key material)
.env
.env.*
*.pem
*.key

# Leftover local model weights are never part of the image.
models/
*.gguf
*.bin

# Local runtime state: catalog, ledgers, backups, logs
db/
database/*.db
*.db
*.db-wal
*.db-shm
logs/
programs/

# Local dataset artifacts. Only the catalog seed CSV is a build input. Exercise
# pictures and GIFs are stored in the private R2 bucket and served through the
# API, so they stay out along with the raw dump and local runtime data.
data/*
data/images/
data/videos/
!data/processed_exercises.csv

# Future Flutter client (not part of the API image)
mobile/

# Local caches & artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# Agent tooling and design/test scratch (a local .claude/ can hold GBs of
# worktrees; none of it is a build input, and it slows every `fly deploy`)
.claude/
.pytest_cwd/
UI_app_design/
.agents/
.wrangler/
plans/
# Only the privacy policy is read at runtime (service/privacy_policy.py).
docs/*
!docs/PRIVACY_POLICY.md

# Git & IDE
.git/
.gitignore
.vscode/
.idea/
