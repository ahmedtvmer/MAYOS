+        addTearDown(tester.view.resetDevicePixelRatio);
+        await _pumpApp(tester, mode);
+        _westernDigits(tester);
+        await _capture(tester, 'home-$suffix');
+        await tester.drag(find.byType(ListView).first, const Offset(0, -500));
+        await tester.pump(const Duration(milliseconds: 400));
+        await _capture(tester, 'home-detail-$suffix');
+        await tester.drag(find.byType(ListView).first, const Offset(0, 1000));
+        await tester.pump(const Duration(milliseconds: 400));
+        await tester.ensureVisible(find.text('ابدأ التمرين'));
+        await tester.tap(find.text('ابدأ التمرين'));
+        await _ready(tester, find.byKey(const ValueKey('logger.cell.0.0.kg')));
+        await _capture(tester, 'logger-$suffix');
+        await tester.tap(find.byKey(const ValueKey('logger.cell.0.0.kg')));
+        await _ready(tester, find.byKey(const ValueKey('logger.key.1')));
+        _keyOrder(tester);
+        for (final digit in ['2', '7', '.', '5']) {
+          await tester.tap(find.byKey(
+              ValueKey(digit == '.' ? 'logger.key.dot' : 'logger.key.$digit')));
+          await tester.pump();
+        }
+        _westernDigits(tester);
+        expect(find.text('27.5'), findsWidgets);
+        if (size.width == 360) {
+          await _capture(tester, 'logger-keypad-initial-$suffix');
+        }
+        // Show the same manual scroll a player can use after the existing
+        // reveal logic misses a row behind the short-phone keypad.
+        await tester
+            .ensureVisible(find.byKey(const ValueKey('logger.cell.0.0.kg')));
+        await tester.pump(const Duration(milliseconds: 400));
+        await _capture(tester, 'logger-keypad-$suffix');
+        await tester.tap(find.byKey(const ValueKey('logger.key.hide')));
+        await tester.pump(const Duration(milliseconds: 400));
+        await tester
+            .ensureVisible(find.byKey(const ValueKey('logger.cell.0.0.rir')));
+        await tester.tap(find.byKey(const ValueKey('logger.cell.0.0.rir')));
+        await _ready(tester, find.byKey(const ValueKey('logger.rir.0')));
+        expect(
+            tester.getCenter(find.byKey(const ValueKey('logger.rir.0'))).dx,
+            lessThan(tester
+                .getCenter(find.byKey(const ValueKey('logger.rir.5')))
+                .dx));
+        if (size.width == 412 && mode == ThemeMode.dark) {
+          await _capture(tester, 'logger-rir-$suffix');
+        }
+        await tester.tap(find.byKey(const ValueKey('logger.key.hide')));
+        await tester.pump(const Duration(milliseconds: 400));
+        if (size.width == 412 && mode == ThemeMode.dark) {
+          final row = find.byKey(const ValueKey('logger.row.0.0'));
+          await tester.ensureVisible(row);
+          final gesture = await tester.startGesture(tester.getCenter(row));
+          await gesture.moveBy(const Offset(20, 0));
+          await tester.pump();
+          await gesture.moveBy(const Offset(90, 0));
+          await tester.pump();
+          await _capture(tester, 'logger-swipe-$suffix');
+          await gesture.cancel();
+          await tester.pump(const Duration(milliseconds: 400));
+        }
+        await tester.pumpWidget(const SizedBox());
+        await tester.pump();
+      }, skip: !_enabled);
+      testWidgets('actual Arabic mixed chat $suffix', (tester) async {
+        tester.view.physicalSize = size * 2;
+        tester.view.devicePixelRatio = 2;
+        addTearDown(tester.view.resetPhysicalSize);
+        addTearDown(tester.view.resetDevicePixelRatio);
+        await _pumpApp(tester, mode);
+        await tester.tap(find.byIcon(Icons.chat_bubble_outline));
+        await _ready(tester, find.text(_input));
+        _westernDigits(tester);
+        await _capture(tester, 'chat-$suffix');
+        await tester.drag(
+            find.byType(CustomScrollView).first, const Offset(0, -250));
+        await tester.pump(const Duration(milliseconds: 400));
+        await _capture(tester, 'chat-detail-$suffix');
