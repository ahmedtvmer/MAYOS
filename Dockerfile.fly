# Fly.io production image for the MAYOS API (hosted LLM backend).
#
# FastAPI service with hosted OpenAI-compatible chat inference.
# The catalog, ledgers, and backup work area live on the mounted /data volume via
# MAYOS_DATA_DIR (see fly.toml and docs/DEPLOYMENT.md).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 \
    MODEL_DEVICE=cpu

WORKDIR /app

# curl: container healthcheck. sqlite3: operator inspection/verification.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY requirements-fly.txt .

# ONNX Runtime replaces the former PyTorch embedding runtime.
RUN uv pip install --system -r requirements-fly.txt

# Bake the ONNX graph, tokenizer and Sentence Transformers configs so boot and
# vector seeding never fetch from Hugging Face.
COPY core/embeddings.py /app/core/embeddings.py
RUN python -c "from core.embeddings import download_model_files; download_model_files()"
ENV HF_HUB_OFFLINE=1

# Keep explicit COPY instructions so the Fly build fails fast if either seed
# file is missing. The production catalog CSV is operator-provided and ignored;
# the curation CSV is tracked and accompanies it for seeding.
COPY data/processed_exercises.csv /app/data/processed_exercises.csv
COPY data/exercise_curation.csv /app/data/exercise_curation.csv

COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=90s \
  CMD curl -f http://localhost:8000/healthz || exit 1

# One Uvicorn worker: SQLite is a single writer and the API Machine owns the volume.
CMD ["uvicorn", "svc.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
