# Fly.io production image for the MYOS API (hosted LLM backend).
#
# FastAPI service with hosted OpenAI-compatible chat inference.
# The catalog, ledgers, and backup work area live on the mounted /data volume via
# MAYOS_DATA_DIR (see fly.toml and docs/DEPLOYMENT.md).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 \
    ARABIC_EMBEDDING_MODEL=intfloat/multilingual-e5-small \
    MODEL_DEVICE=cpu

WORKDIR /app

# curl: container healthcheck. sqlite3: operator inspection/verification.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY requirements-fly.txt .

# ONNX Runtime replaces the former PyTorch embedding runtime.
RUN uv pip install --system -r requirements-fly.txt

# Bake the ONNX graphs, tokenizers and Sentence Transformers configs so boot and
# vector seeding never fetch from Hugging Face: the English BGE model for triage
# and catalog search, plus the separate multilingual-e5-small Arabic guard model
# (ADR 081). The Arabic O4 graph adds roughly 235 MiB to the image. Measured in
# the core.embeddings process (both models, scoped to that interpreter, not a
# deployed-API measurement) it adds ~581 MB resident / ~648 MB peak, so the
# combined model-process peak is ~908 MB. The owner chose to keep 512 MB RAM
# with the existing 512 MB swap; the first Arabic semantic query loads lazily
# and may incur swap pressure. Verify deployed RSS and latency after deployment;
# see docs/design-review/149/.
COPY core/embeddings.py /app/core/embeddings.py
RUN python -c "from core.embeddings import download_model_files, download_arabic_model_files; download_model_files(); download_arabic_model_files()"
ENV HF_HUB_OFFLINE=1

# Keep explicit COPY instructions so the Fly build fails fast if either seed
# file is missing. The production catalog CSV is operator-provided and ignored;
# the curation CSV is tracked and accompanies it for seeding.
COPY data/processed_exercises.csv /app/data/processed_exercises.csv
COPY data/exercise_curation.csv /app/data/exercise_curation.csv

COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=90s \
  CMD curl -f http://localhost:8000/healthz || exit 1

# One Uvicorn worker: SQLite is a single writer and the API Machine owns the volume.
CMD ["uvicorn", "svc.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
