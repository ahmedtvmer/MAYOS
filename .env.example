# Copy to .env and fill in secrets. Never commit .env.
# Model resolution: MODEL_PATH / JUDGE_MODEL_PATH win; else MODEL_DIR + registry filename.
MODEL_PATH="models/Qwen3.5-4B-Q4_K_M.gguf"
JUDGE_MODEL_PATH="models/Qwen3.5-9B-Q4_K_M.gguf"
MODEL_DIR="models"
# -1 = offload all layers to GPU. docker-compose overrides to 16 for the shared host.
N_GPU_LAYERS=-1
JUDGE_N_GPU_LAYERS=18
MODEL_DEVICE=cuda
EMBEDDING_DEVICE=cuda
EMBEDDING_MODEL='BAAI/bge-small-en-v1.5'
OMP_NUM_THREADS=6
# Required by docker-compose. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret
# Token lifetime in hours (default 2).
JWT_EXPIRY_HOURS=2
API_BASE_URL=http://localhost:8000
