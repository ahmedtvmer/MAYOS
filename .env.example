# Copy to .env and fill in secrets. Never commit .env.
# Inference backend: `local` (default, GGUF below) or `openai` (hosted
# OpenAI-compatible endpoint, e.g. DeepInfra). Local-first is preserved.
LLM_BACKEND=local
# --- Cloud backend (only used when LLM_BACKEND=openai) ---
# Shared OpenAI-compatible base URL and key across all roles.
LLM_API_BASE=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
# Per-role model IDs (env-overridable; verify the exact hosted variant at signup).
LLM_MODEL=Qwen/Qwen3.5-9B
JUDGE_MODEL=Qwen/Qwen3.5-27B
COACH_MODEL=Qwen/Qwen3.5-27B
COACH_MAX_TOKENS=512
# Hosted judge output budget. 280 truncated hosted 9B structured judgments (all
# five onboarding generalization cases returned unparseable JSON). The hosted
# default is now 700; the local GGUF judge default remains 280. Uncomment to
# override either backend explicitly.
# JUDGE_MAX_TOKENS=700
# Reasoning is disabled by default so tight output budgets stay productive.
# Set true to enable, or override the whole body with JSON via LLM_EXTRA_BODY.
# LLM_ENABLE_THINKING=false
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Concurrent inference requests: 1 serializes local llama.cpp; raise (e.g. 4)
# for the cloud backend once it is known to be thread-safe.
# LLM_MAX_CONCURRENT=1
# Cloud request bounds so a stalled hosted provider fails fast instead of
# hanging a turn or an eval run. Seconds / retry count; invalid values fall
# back to these defaults.
# LLM_REQUEST_TIMEOUT=60
# LLM_MAX_RETRIES=1
# LLM_STREAM_CHUNK_TIMEOUT=30
# Model resolution: MODEL_PATH / JUDGE_MODEL_PATH win; else MODEL_DIR + registry filename.
MODEL_PATH="models/Qwen3.5-4B-Q4_K_M.gguf"
JUDGE_MODEL_PATH="models/Qwen3.5-9B-Q4_K_M.gguf"
MODEL_DIR="models"
# -1 = offload all layers to GPU. docker-compose overrides to 16 for the shared host.
N_GPU_LAYERS=-1
JUDGE_N_GPU_LAYERS=18
MODEL_DEVICE=cuda
EMBEDDING_DEVICE=cuda
EMBEDDING_MODEL='BAAI/bge-small-en-v1.5'
OMP_NUM_THREADS=6
# Required by docker-compose. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret
# Token lifetime in hours (default 2).
JWT_EXPIRY_HOURS=2
# Remember-me token lifetime in hours, clamped to 1–8760 (default 720 = 30 days).
JWT_REMEMBER_ME_HOURS=720
# --- Persistent data root (containers / Fly) ---
# Unset => local development keeps the repo ./db layout (unchanged).
# Set to the mounted volume in production; fly.toml sets /data. When set,
# MAYOS_REQUIRE_PERSISTENT_DATA=true makes boot and /readyz fail closed unless
# the root is a writable mount point.
# MAYOS_DATA_DIR=/data
# MAYOS_REQUIRE_PERSISTENT_DATA=true
API_BASE_URL=http://localhost:8000
# Streamlit origin (CORS) and reset-link base.
UI_BASE_URL=http://localhost:8501
# Password-reset token lifetime in minutes, clamped to 5–120 (default 30).
RESET_TOKEN_TTL_MINUTES=30
# Owner-issued coach invite lifetime in minutes, clamped to 5–43200 (default 1440).
# Issuance is operator-only via scripts/issue_coach_invite.py; there is no HTTP endpoint.
COACH_INVITE_TTL_MINUTES=1440
# Outbound email for self-service recovery. Unset SMTP_HOST = console-dev
# backend (reset link is logged server-side, never sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mayos.local
# Optional model pins / tuning (defaults mirror previous behavior).
# MODEL_REVISION=
# MODEL_SHA256=
# LLM_N_CTX=2048
# LLM_MAX_TOKENS=200
# LLM_N_BATCH=512
# LLM_THREADS=  # defaults to OMP_NUM_THREADS, else half the CPUs
# Skips eager model warmup at boot (healthz reports model=false). The real
# GGUF lazy-loads on the first inference. NOT a mock switch: only TESTING=1
# substitutes the mock model.
# SKIP_LLM_LOAD=true
