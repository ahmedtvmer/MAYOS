# Copy to .env and fill in secrets. Never commit .env.
# Model resolution: MODEL_PATH / JUDGE_MODEL_PATH win; else MODEL_DIR + registry filename.
MODEL_PATH="models/Qwen3.5-4B-Q4_K_M.gguf"
JUDGE_MODEL_PATH="models/Qwen3.5-9B-Q4_K_M.gguf"
MODEL_DIR="models"
# -1 = offload all layers to GPU. docker-compose overrides to 16 for the shared host.
N_GPU_LAYERS=-1
JUDGE_N_GPU_LAYERS=18
MODEL_DEVICE=cuda
EMBEDDING_DEVICE=cuda
EMBEDDING_MODEL='BAAI/bge-small-en-v1.5'
OMP_NUM_THREADS=6
# Required by docker-compose. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret
# Token lifetime in hours (default 2).
JWT_EXPIRY_HOURS=2
API_BASE_URL=http://localhost:8000
# Streamlit origin (CORS) and reset-link base.
UI_BASE_URL=http://localhost:8501
# Password-reset token lifetime in minutes, clamped to 5–120 (default 30).
RESET_TOKEN_TTL_MINUTES=30
# Outbound email for self-service recovery. Unset SMTP_HOST = console-dev
# backend (reset link is logged server-side, never sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@myos.local
# Optional model pins / tuning (defaults mirror previous behavior).
# MODEL_REVISION=
# MODEL_SHA256=
# LLM_N_CTX=2048
# LLM_MAX_TOKENS=200
# LLM_N_BATCH=512
# LLM_THREADS=  # defaults to OMP_NUM_THREADS, else half the CPUs
# Skips eager model warmup at boot (healthz reports model=false). The real
# GGUF lazy-loads on the first inference. NOT a mock switch: only TESTING=1
# substitutes the mock model.
# SKIP_LLM_LOAD=true
