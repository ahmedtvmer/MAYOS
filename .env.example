# Copy to .env and fill in secrets. Never commit .env.
# Hosted OpenAI-compatible chat endpoint (for example, DeepInfra).
LLM_API_BASE=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
# Per-role model IDs (env-overridable; verify the exact hosted variant at signup).
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
JUDGE_MODEL=Qwen/Qwen3.5-27B
COACH_MODEL=deepseek-ai/DeepSeek-V4-Flash
COACH_MAX_TOKENS=512
# Hosted judge output budget. The default leaves room for structured judgments.
# JUDGE_MAX_TOKENS=700
# Player requests have no extra body by default; this JSON replaces the player body.
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Judge thinking is disabled by default. Set true to opt in, or replace the
# judge body with JSON; {} disables the body regardless of LLM_ENABLE_THINKING.
# LLM_ENABLE_THINKING=true
# JUDGE_EXTRA_BODY={}
# Maximum number of overlapping hosted inference requests.
# LLM_MAX_CONCURRENT=1
# --- Hosted-model metering, limits, and owner alerting (ADR 038, ticket #39) ---
# Player program mutations (exercise substitution and exact Undo).
# RATE_LIMIT_PROGRAM_MUTATE=30/minute
# Per-model price table in USD per 1M tokens, merging over the built-in trial
# defaults. Unknown models are metered at cost 0 with a logged warning.
# MODEL_PRICING_JSON={"Qwen/Qwen3.5-9B":{"input":0.10,"output":0.30}}
# Per immutable-account model limits, enforced before any call or stream starts.
# One user turn counts as one request even if it makes several model calls.
# MODEL_RATE_LIMIT_REQUESTS=20   # requests/minute/account (0 disables)
# MODEL_DAILY_TOKEN_LIMIT=200000 # input+output tokens/UTC day/account (0 disables)
# Owner alert when projected month-to-date spend reaches the threshold. The
# projection uses actual / max(elapsed fraction of the UTC month, 0.1). It is
# evaluated on the hourly alert sweep (never on an inference thread), is claimed
# once per calendar month, and retries delivery until the email succeeds;
# OWNER_ALERT_EMAIL receives the notice (unset means the alert is logged only).
# Review usage with scripts/model_usage_report.py.
# MODEL_SPEND_ALERT_USD=50
# OWNER_ALERT_EMAIL=owner@example.com
# --- Product analytics (ADR 040) ---
# Server analytics is disabled without a key and whenever TESTING=1.
# Leave POSTHOG_API_KEY blank locally (or use a separate dev project's key):
# the production key belongs only in Fly secrets, so local runs never send
# into trial data. Never put POSTHOG_PERSONAL_API_KEY in a local .env.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# Private person-deletion API credentials; scope only to person:write for MAYOS.
# POSTHOG_PERSONAL_API_KEY=
# Restrict the personal API key to the MAYOS project.
# POSTHOG_PROJECT_ID=
# Defaults to the PostHog EU Cloud API host; set only for another deployment.
# POSTHOG_API_HOST=https://eu.posthog.com
# MAYOS_ENV=development
# Account cohort set once at signup; change to public at public launch.
# MAYOS_RELEASE_PHASE=closed_trial
# Coach Pro entitlement during the invitation-only closed trial. Defaults on;
# set false when public launch begins so stored Coach plan state applies.
# COACH_CLOSED_TRIAL_OVERRIDE=true
# --- Optional coach AI analysis (issue #45, ADR 049) ---
# Off by default. Enabling also requires COACH_AI_EVAL_REPORT: a recorded
# LIVE report (from tests/eval/run_coach_evaluation.py --write-report) whose
# pass=true, prompt_hash matches the current prompt version, model identity
# matches the configured hosted coach model, and whose privacy + evaluation gates both
# recorded pass with runs that re-derive to the same verdict — otherwise
# startup logs the refusal and the feature stays off. See docs/DEPLOYMENT.md.
# COACH_AI_ENABLED=false
# COACH_AI_EVAL_REPORT=reports/coach_ai_eval.json
# RATE_LIMIT_COACH_ASSISTANT=30/minute
# --- Optional Checkpoint review wording (issue #222, ADR 052) ---
# Off by default. Enabling requires a passing live report from the player model.
# CHECKPOINT_REVIEW_AI_ENABLED=false
# CHECKPOINT_REVIEW_EVAL_REPORT=reports/checkpoint_review_eval.json
# Cloud request bounds so a stalled hosted provider fails fast instead of
# hanging a turn or an eval run. Seconds / retry count; invalid values fall
# back to these defaults.
# LLM_REQUEST_TIMEOUT=60
# LLM_MAX_RETRIES=1
# LLM_STREAM_CHUNK_TIMEOUT=30
# Embeddings remain local to the service for clinical guard and catalog search.
MODEL_DEVICE=cpu
EMBEDDING_MODEL='BAAI/bge-small-en-v1.5'
OMP_NUM_THREADS=6
# Required by docker-compose. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret
# Token lifetime in hours (default 2).
JWT_EXPIRY_HOURS=2
# Remember-me token lifetime in hours, clamped to 1–8760 (default 720 = 30 days).
JWT_REMEMBER_ME_HOURS=720
# --- Persistent data root (containers / Fly) ---
# Unset => local development keeps the repo ./db layout (unchanged).
# Set to the mounted volume in production; fly.toml sets /data. When set,
# MAYOS_REQUIRE_PERSISTENT_DATA=true makes boot and /readyz fail closed unless
# the root is a writable mount point.
# MAYOS_DATA_DIR=/data
# MAYOS_REQUIRE_PERSISTENT_DATA=true
# Durable account-deletion store (ADR 015/039). Defaults to deletions.db beside
# the catalog. Keep it OUTSIDE any catalog snapshot: back it up separately and
# never restore an older copy over the live file.
# MAYOS_DELETIONS_DB=/data/deletions.db
# --- Daily online backups (#41) ---
# In-process in the always-on API Machine: once at startup, then every interval.
# 0 disables the loop (use scripts/backup_now.py to run one manually). The job is
# idempotent per UTC day and retriable, and writes consistent SQLite snapshots of
# the catalog + every ledger of a live account under
# <backups_dir>/daily/<YYYYMMDD>/ (ledger copies under ledgers/). It creates at
# most one snapshot per UTC day, so the hourly default only retries a failed day
# sooner.
# MAYOS_DAILY_BACKUP_INTERVAL_SECONDS=3600
# Bounded retention in days; clamped to 1..30 because ADR 015 discloses that a
# restricted whole-catalog recovery backup may retain deleted rows for up to 30
# days. Longer windows would exceed what users were told.
# MAYOS_BACKUP_RETENTION_DAYS=30
API_BASE_URL=http://localhost:8000
# CORS origin(s) for the web app, comma-separated (e.g. the Pages origin plus
# http://localhost:7357 for local dev). Not used for reset links.
UI_BASE_URL=http://localhost:7357
# Reset-link / App Link base. Must be the public host serving both
# /reset-password and /.well-known/assetlinks.json. In production this host must
# be identical in RESET_LINK_BASE_URL, the Android App Link intent-filter host
# (-PappLinkHost), and where assetlinks.json is served. There is no UI_BASE_URL
# fallback; the localhost default is for development only.
# RESET_LINK_BASE_URL=https://mayos-api.fly.dev
# Android App Link association served at /.well-known/assetlinks.json. Set the
# app's signing-certificate SHA-256 fingerprint(s), comma-separated; each entry
# may use upper/lower case and colons or not, and is normalised to the uppercase
# colon-separated form. Include both the upload key and the Play App Signing
# cert when distributing via Play. Invalid entries are skipped; with no valid
# fingerprint the endpoint returns 404.
# ANDROID_APP_PACKAGE=com.mayos.mayos_mobile
# ANDROID_APP_SHA256_CERT_FINGERPRINTS=AA:BB:CC:…,DD:EE:FF:…
# Owner contact rendered on the public privacy policy (GET /privacy). Unset,
# the page still serves with an explicit placeholder and logs a warning.
# PRIVACY_CONTACT_EMAIL=owner@example.com
# Password-reset token lifetime in minutes, clamped to 5–120 (default 30).
RESET_TOKEN_TTL_MINUTES=30
# Recovery-email verification code lifetime in minutes, clamped to 5–60 (default 10).
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
# Owner-issued coach invite lifetime in minutes, clamped to 5–43200 (default 1440).
# Issuance is operator-only via scripts/issue_coach_invite.py; there is no HTTP endpoint.
COACH_INVITE_TTL_MINUTES=1440
# Outbound email for self-service recovery. Unset SMTP_HOST = console-dev
# backend (reset link is logged server-side, never sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mayos.local
# Skips eager hosted model warmup at boot (healthz reports model=false).
# SKIP_LLM_LOAD=true
